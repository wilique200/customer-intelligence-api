# Model hosting
HF_REPO_ID=wilique200-daniel/customer-intelligence-churn-model

# CORS — set to your real Vercel URL once it exists, e.g.
# https://pulse-frontend.vercel.app (no trailing slash)
ALLOWED_ORIGIN=*

# Gemini — free key from aistudio.google.com, no card needed
GEMINI_API_KEY=

# Supabase — Project Settings -> API in your Supabase dashboard
# SUPABASE_SERVICE_KEY is the SERVICE ROLE key, not the anon/public one —
# treat it like a password, never expose it to the frontend
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
